#!/bin/bash
#
# setup_storage
#
# This script is _sourced_ from install-chrx (not exec'ed),
# so all functions and variables from there are available.
#
# It cannot be run directly from the commandline.
#

eval_try umount -R ${CHRX_INSTALL_ROOT} 2>/dev/null ## be safe.

## get_largest_cros_blockdev -- find the internal disk that carries a ChromeOS
## GPT (STATE + KERN-A + ROOT-A), independent of what we booted from. Ported from
## crap.sh. Lets chrx target the internal ChromeOS disk when run from a live USB
## (where `rootdev` returns the USB stick, or isn't present at all), while still
## resolving the same disk when run from within ChromeOS.
get_largest_cros_blockdev() {
  local largest size dev_name tmp_size remo
  size=0
  for blockdev in /sys/block/*; do
    dev_name="${blockdev##*/}"
    echo "$dev_name" | grep -q '^\(loop\|ram\)' && continue
    tmp_size=$(cat "$blockdev"/size)
    remo=$(cat "$blockdev"/removable)
    if [ "$tmp_size" -gt "$size" ] && [ "${remo:-0}" -eq 0 ]; then
      case "$(sfdisk -d "/dev/$dev_name" 2>/dev/null)" in
        *'name="STATE"'*'name="KERN-A"'*'name="ROOT-A"'*)
          largest="/dev/$dev_name"
          size="$tmp_size"
          ;;
      esac
    fi
  done
  echo "$largest"
}

## resize_stateful_clean -- shrink the STATE partition SAFELY, FILESYSTEM-FIRST,
## so ChromeOS does NOT flag STATE "missing or damaged" and powerwash on the next
## boot. Ported from CRaP's resize_stateful_menu (chrultrabook/crap). This is what
## makes the no-flag dual-boot path single-pass and inherently safe: unlike the
## legacy chrx path (which shrank the PARTITION without the FILESYSTEM and leaned
## on a powerwash + reboot + second pass to rebuild STATE), we resize the ext4
## filesystem to fit first, then shrink the partition to match, then partx -u
## (no reboot). ChromeOS then mounts a valid, just-smaller STATE.
##   $1 = new STATE size in SECTORS ; $2 = STATE partition device (e.g. .../p1)
## Requires STATE unmounted -- true on a live USB (toram). In-ChromeOS callers
## must chromeos_shutdown first; we refuse outright if it is still mounted.
resize_stateful_clean() {
  local new_sectors="$1" statepart="$2"
  local cur_sectors sector_size block_size new_blocks

  if [ -z "${new_sectors}" ] || [ "${new_sectors}" -le 0 ]; then
    echo_fail "resize_stateful_clean: bad new size '${new_sectors}'."; return 1
  fi
  cur_sectors="`cgpt show -i 1 -n -s -q ${CHRX_TARGET_DISK}`"
  if [ "${new_sectors}" -ge "${cur_sectors}" ]; then
    echo_fail "resize_stateful_clean: new ${new_sectors} >= current ${cur_sectors} sectors; this path only shrinks."; return 1
  fi

  ## NEVER shrink a mounted stateful: ext4 cannot shrink online, and shrinking the
  ## partition under a live filesystem IS the dirty-shrink powerwash trap.
  if grep -q "^${statepart}[[:space:]]" /proc/mounts 2>/dev/null; then
    echo_fail "STATE (${statepart}) is MOUNTED -- refusing to shrink."
    echo_fail "Run from a live USB (STATE offline), or unmount/chromeos_shutdown first."
    return 1
  fi

  block_size="`tune2fs -l ${statepart} 2>/dev/null | awk -F: '/Block size/ {gsub(/[^0-9]/,\"\",$2); print $2}'`"
  if [ -z "${block_size}" ]; then
    echo_fail "resize_stateful_clean: ${statepart} has no readable ext4 superblock (tune2fs failed)."; return 1
  fi
  sector_size=512
  new_blocks=$(( (new_sectors * sector_size) / block_size ))

  echo_info "Clean shrink of STATE (${statepart}): fs -> ${new_blocks} x ${block_size}B blocks, then partition -> ${new_sectors} sectors."
  eval_try e2fsck -fy ${statepart}
  if ! resize2fs ${statepart} ${new_blocks}; then
    echo_fail "resize2fs failed -- STATE partition left UNCHANGED (safe). Aborting."
    return 1
  fi
  if ! cgpt add -i 1 -s ${new_sectors} ${CHRX_TARGET_DISK}; then
    echo_fail "cgpt shrink of STATE failed after fs resize -- do NOT boot ChromeOS; inspect with 'cgpt show ${CHRX_TARGET_DISK}'."
    return 1
  fi
  eval_try partx -u -n 1 ${CHRX_TARGET_DISK}
  echo_info "STATE shrunk cleanly -- no powerwash will be triggered."
}

## carve_kernc_rootc -- create KERN-C (i6) + ROOT-C (i7) in the free space AFTER
## the (already-shrunk) STATE partition, then partx -u (no reboot). Shared by the
## -S path (CRaP pre-shrank STATE) and the no-flag path (resize_stateful_clean
## just shrank STATE). STATE (-i 1) is READ, never rewritten, here.
carve_kernc_rootc() {
  local kernc_size kernc_start rootc_start rootc_size
  local stateful_start state_size disk_total_sectors
  local min_rootc_size=2097152   # ~1 GiB floor for a usable Linux root

  kernc_size=32768               # KERN-C is always 16 MiB
  stateful_start="`cgpt show -i 1 -n -b -q ${CHRX_TARGET_DISK}`"
  state_size="`cgpt show -i 1 -n -s -q ${CHRX_TARGET_DISK}`"

  kernc_start=$(( stateful_start + state_size ))
  rootc_start=$(( kernc_start + kernc_size ))

  disk_total_sectors="`blockdev --getsz ${CHRX_TARGET_DISK} 2>/dev/null`"
  if [ -z "${disk_total_sectors}" ]; then
    disk_total_sectors=$(( `cgpt show ${CHRX_TARGET_DISK} | awk '/Sec GPT table/{print $1; exit}'` + 33 ))
  fi
  ## reserve 34 sectors at the end for the secondary GPT (header + 32 entries)
  rootc_size=$(( disk_total_sectors - rootc_start - 34 ))

  echo "  stateful_start ${stateful_start} (unchanged)"
  echo "  state_size     ${state_size} (unchanged -- STATE NOT re-shrunk here)"
  echo "  kernc_start    ${kernc_start}"
  echo "  kernc_size     ${kernc_size}"
  echo "  rootc_start    ${rootc_start}"
  echo "  rootc_size     ${rootc_size}"

  ## Sanity guard: if too little free space follows STATE, rootc_size comes out
  ## tiny/negative -- cgpt would make a junk ROOT-C. Abort BEFORE touching the GPT.
  if [ "${rootc_size}" -lt "${min_rootc_size}" ]; then
    echo_fail "ROOT-C free space too small: ${rootc_size} sectors (need >= ${min_rootc_size})."
    echo_fail "STATE was not shrunk enough -- free more space, then re-run."
    exit 1
  fi

  cgpt add -i 6 -b ${kernc_start} -s ${kernc_size} -l KERN-C -t "kernel" ${CHRX_TARGET_DISK}
  cgpt add -i 7 -b ${rootc_start} -s ${rootc_size} -l ROOT-C ${CHRX_TARGET_DISK}

  echo_info "Updating kernel partition table (partx -u)..."
  partx -u ${CHRX_TARGET_DISK}
  echo_info "Partitions configured without reboot. Continuing to install..."
}


## --- removable / external target helpers (USB install path) ----------------
## A USB stick or USB-SSD target lets a user install Linux WITHOUT touching the
## internal ChromeOS disk -- the safest "try Linux" route, and the one most
## non-technical users pick. These enumerate external drives and, crucially,
## EXCLUDE the live medium we booted from so we never install over our own stick.
is_removable_dev() {
  local _d="${1##*/}"
  [ "$(cat /sys/block/${_d}/removable 2>/dev/null)" = "1" ] && return 0
  readlink -f "/sys/block/${_d}" 2>/dev/null | grep -q '/usb[0-9]' && return 0
  return 1
}

boot_blockdev() {
  ## whole-disk device the live medium booted from, so we can keep the boot stick
  ## OUT of the target list. toram-aware: under `toram`, /run/live/medium is a
  ## tmpfs (RAM copy) not the stick, so fall back to finding the stick by our ISO
  ## volume label, then by any iso9660 signature. Best-effort -- empty if the
  ## stick was physically removed after the toram copy (nothing to exclude then).
  local _src _pk
  _src="$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null | head -1)"
  case "${_src}" in /dev/*) ;; *) _src="" ;; esac   # ignore tmpfs (toram) / non-devices
  [ -z "${_src}" ] && _src="$(findmnt -n -o SOURCE /lib/live/mount/medium 2>/dev/null | head -1)"
  case "${_src}" in /dev/*) ;; *) _src="" ;; esac
  [ -z "${_src}" ] && _src="$(blkid -L CPH-CHRX-LIVE 2>/dev/null | head -1)"
  [ -z "${_src}" ] && _src="$(blkid -o device -t TYPE=iso9660 2>/dev/null | head -1)"
  [ -z "${_src}" ] && return 0
  _pk="$(lsblk -no PKNAME ${_src} 2>/dev/null | head -1)"
  [ -n "${_pk}" ] && echo "/dev/${_pk}" || echo "${_src}"
}

list_removable_targets() {
  ## emit "dev|size|model" per removable/external disk, minus the boot stick
  local _boot _b _d _size _model
  _boot="$(boot_blockdev)"
  for _b in /sys/block/*; do
    _d="${_b##*/}"
    case "${_d}" in loop*|ram*|zram*|dm-*|md*) continue ;; esac
    is_removable_dev "/dev/${_d}" || continue
    [ "/dev/${_d}" = "${_boot}" ] && continue
    _size="$(lsblk -dno SIZE /dev/${_d} 2>/dev/null | tr -d ' ')"
    _model="$(lsblk -dno MODEL /dev/${_d} 2>/dev/null | sed 's/[[:space:]]*$//')"
    echo "/dev/${_d}|${_size}|${_model}"
  done
}

choose_usb_target() {
  ## interactive picker: list external targets, set CHRX_TARGET_DISK to the choice.
  ## returns 1 on none-available / cancel so the caller can fall back to internal.
  local _list _i _dev _size _model _sel
  _list="$(list_removable_targets)"
  if [ -z "${_list}" ]; then
    echo_warn "No removable/external drives found. Insert a USB drive (not the boot stick) and retry."
    return 1
  fi
  echo_info "\nAvailable USB / external install targets:"
  _i=0
  while IFS='|' read -r _dev _size _model; do
    [ -z "${_dev}" ] && continue
    _i=$(( _i + 1 ))
    echo_info "  ${_i}) ${_dev}  ${_size}  ${_model}"
  done <<INNEREOF
${_list}
INNEREOF
  echo_warn "Select a target number (or press [enter] to cancel): \c"
  prompt_if_interactive
  _sel="${PROMPT_RESPONSE}"
  [ -z "${_sel}" ] && return 1
  echo "${_sel}" | grep -q '^[0-9][0-9]*$' || { echo_fail "Not a number."; return 1; }
  _dev="$(printf '%s\n' "${_list}" | sed -n "${_sel}p" | cut -d'|' -f1)"
  [ -z "${_dev}" ] && { echo_fail "Selection out of range."; return 1; }
  CHRX_TARGET_DISK="${_dev}"
  echo_info "Selected USB target: ${ANSI_WHT}${CHRX_TARGET_DISK}${ANSI_RST}"
  return 0
}

set_root_partition() {
  pnum=$1

  case "$CHRX_TARGET_DISK" in
    /dev/sd*)     CHRX_ROOT_PARTITION="${CHRX_TARGET_DISK}${pnum}" ;;
    /dev/mmcblk*) CHRX_ROOT_PARTITION="${CHRX_TARGET_DISK}p${pnum}" ;;
    /dev/nvme*)   CHRX_ROOT_PARTITION="${CHRX_TARGET_DISK}p${pnum}" ;;
    *) echo_fail "\nunrecognized disk device: \"$CHRX_TARGET_DISK\"!"; exit 1 ;;
  esac
}

set_efi_partition() {
  ## Find the EFI System Partition on the target disk.
  ## Preferred: use blkid to find by PARTLABEL (works even when
  ## the kernel hasn't created /dev/sdaN device nodes yet).
  ## Fallback: construct from partition number 12 (ChromeOS default).

  ## Try blkid first — most robust across disk types
  local _efi_dev
  _efi_dev=$(blkid --match-token PARTLABEL=EFI-SYSTEM -o device 2>/dev/null \
    | grep "^${CHRX_TARGET_DISK}" | head -1)

  if [ -n "$_efi_dev" ] && [ -b "$_efi_dev" ]; then
    CHRX_EFI_PARTITION="$_efi_dev"
    return 0
  fi

  ## blkid didn't find it — force kernel to re-read partition table
  partprobe ${CHRX_TARGET_DISK} 2>/dev/null
  sleep 1

  ## Retry blkid after partprobe
  _efi_dev=$(blkid --match-token PARTLABEL=EFI-SYSTEM -o device 2>/dev/null \
    | grep "^${CHRX_TARGET_DISK}" | head -1)

  if [ -n "$_efi_dev" ] && [ -b "$_efi_dev" ]; then
    CHRX_EFI_PARTITION="$_efi_dev"
    return 0
  fi

  ## Final fallback: construct from partition 12 (ChromeOS default)
  local pnum=12
  case "$CHRX_TARGET_DISK" in
    /dev/sd*)     CHRX_EFI_PARTITION="${CHRX_TARGET_DISK}${pnum}" ;;
    /dev/mmcblk*) CHRX_EFI_PARTITION="${CHRX_TARGET_DISK}p${pnum}" ;;
    /dev/nvme*)   CHRX_EFI_PARTITION="${CHRX_TARGET_DISK}p${pnum}" ;;
    *) CHRX_EFI_PARTITION="" ;;
  esac
}

is_efi_bootloader() {
  ## Check if EFI bootloader is selected
  [[ "${CHRX_BOOTLOADER}" == *efi* ]]
}

setup_efi_partition() {
  ## Set up the EFI System Partition (partition 12)
  ## This partition is created by ChromeOS and can be reused for Linux EFI boot
  ##
  ## EFI boot requires UEFI firmware (e.g. MrChromebox full ROM)
  ## Use -b grub-efi-amd64 to enable

  if ! is_efi_bootloader; then
    echo_info "Using Legacy/BIOS bootloader (${CHRX_BOOTLOADER})."
    CHRX_EFI_PARTITION=""
    return 0
  fi

  echo_info "EFI bootloader selected (${CHRX_BOOTLOADER}). Setting up UEFI boot..."

  set_efi_partition

  if [ -z "${CHRX_EFI_PARTITION}" ]; then
    echo_warn "Could not determine EFI partition for disk ${CHRX_TARGET_DISK}"
    return 1
  fi

  if [ ! -b "${CHRX_EFI_PARTITION}" ]; then
    echo_warn "EFI partition ${CHRX_EFI_PARTITION} does not exist"
    CHRX_EFI_PARTITION=""
    return 1
  fi

  echo_info "Setting up EFI System Partition ${CHRX_EFI_PARTITION}..."

  ## Unmount if already mounted
  umount -f ${CHRX_EFI_PARTITION} 2>/dev/null

  ## Format as FAT32 for EFI compatibility
  echo_info "Formatting ${CHRX_EFI_PARTITION} as FAT32 for EFI..."
  mkfs.vfat -F 32 -n EFI ${CHRX_EFI_PARTITION}

  ## Create mount point and mount
  mkdir -p ${CHRX_INSTALL_ROOT}/boot/efi
  mount -t vfat ${CHRX_EFI_PARTITION} ${CHRX_INSTALL_ROOT}/boot/efi

  if [ $? -eq 0 ]; then
    echo_info "EFI partition mounted at ${CHRX_INSTALL_ROOT}/boot/efi"

    ## Create standard EFI directory structure
    mkdir -p ${CHRX_INSTALL_ROOT}/boot/efi/EFI/BOOT

    return 0
  else
    echo_warn "Failed to mount EFI partition"
    CHRX_EFI_PARTITION=""
    return 1
  fi
}

## Guided target selection when no explicit -t target was given. Honors
## CHRX_TARGET_MODE:  usb -> pick a removable/external drive (internal ChromeOS
## untouched);  ask -> prompt internal-vs-USB;  internal (default) -> dual-boot on
## the internal ChromeOS disk. The friendly front-end just sets CHRX_TARGET_MODE.
if [ -z "${CHRX_TARGET_DISK}" ] && [ -z "${CHRX_SKIP_PARTITIONING}" ]; then
  case "${CHRX_TARGET_MODE:-internal}" in
    usb)
      choose_usb_target || { echo_fail "No USB target selected -- aborting."; exit 1; }
      ;;
    ask)
      echo_info "\nWhere should Linux be installed?"
      echo_info "  1) A USB / external drive  (recommended -- your ChromeOS is NOT touched)"
      echo_info "  2) Alongside ChromeOS on the internal disk  (dual-boot)"
      echo_warn "Choose [1/2]: \c"
      prompt_if_interactive
      case "${PROMPT_RESPONSE}" in
        1) choose_usb_target || { echo_fail "No USB target selected -- aborting."; exit 1; } ;;
        *) : ;;
      esac
      ;;
    *) : ;;
  esac
fi

if [ "${CHRX_TARGET_DISK}" ]; then
  ## Whole-disk install to ${CHRX_TARGET_DISK}. If it is a removable/external
  ## device (USB stick or USB-SSD) the internal ChromeOS disk is NOT touched --
  ## the safe "try Linux without risking my data" path most users will pick.
  if is_removable_dev "${CHRX_TARGET_DISK}"; then
    echo_info "Target ${ANSI_WHT}${CHRX_TARGET_DISK}${ANSI_RST} is removable/external -- your internal ChromeOS disk will NOT be modified."
  else
    echo_warn "Target ${ANSI_WHT}${CHRX_TARGET_DISK}${ANSI_RST} is an INTERNAL/fixed disk -- this ERASES the WHOLE disk (not a dual-boot)."
  fi
  echo_warn "${ANSI_YEL}WARNING: ALL data on ${CHRX_TARGET_DISK} will be erased!${ANSI_RST}"
  echo_warn "Press [enter] to continue or CTRL-C to quit: \c"
  prompt_if_interactive

  echo_info "Setting up target disk ${CHRX_TARGET_DISK}..."
  eval_try wipefs -a ${CHRX_TARGET_DISK} 2>/dev/null

  if is_efi_bootloader; then
    ## Portable UEFI whole-disk layout: p1 = ESP (FAT32, 512 MiB, EFI-SYSTEM),
    ## p2 = root. The chroot's grub-install --removable writes \EFI\BOOT\BOOTX64.EFI,
    ## so the device boots on ANY UEFI machine (incl. any Chromebook's MrChromebox
    ## edk2) with NO per-machine NVRAM boot entry.
    ##
    ## Use sgdisk, NOT cgpt, for this fresh whole-disk target. `cgpt create` writes
    ## a protective MBR the Linux kernel rejects ("valid GPT with corrupt MBR"), so
    ## partition nodes never appear -- verified on real USB hardware 2026-07-16
    ## (is_removable_dev/detection worked, but /dev/sdX1..2 did not materialize).
    ## A USB target needs no ChromeOS-GPT compatibility, so sgdisk -- which writes a
    ## correct PMBR -- is the right tool. cgpt is retained ONLY for the internal
    ## ChromeOS-disk paths (STATE shrink / KERN-C carve) that must stay compatible.
    if ! command -v sgdisk >/dev/null 2>&1; then
      echo_fail "sgdisk (gdisk) not found -- required for the whole-disk UEFI layout."; exit 1
    fi
    _dsz="$(blockdev --getsz ${CHRX_TARGET_DISK})"
    if [ "${_dsz:-0}" -lt 3145728 ]; then   # ~1.5 GiB floor (512 MiB ESP + ~1 GiB root)
      echo_fail "Target ${CHRX_TARGET_DISK} is too small for ESP + root (need >= ~1.5 GiB)."; exit 1
    fi
    echo_info "Creating GPT (ESP + root) for portable UEFI boot..."
    eval_crit sgdisk --zap-all ${CHRX_TARGET_DISK}
    eval_crit sgdisk -a 2048 -n 1:2048:+512M -t 1:ef00 -c 1:EFI-SYSTEM -n 2:0:0 -t 2:8300 -c 2:ROOT ${CHRX_TARGET_DISK}
    eval_try partprobe ${CHRX_TARGET_DISK} 2>/dev/null
    set_root_partition 2
    ## CHRX_EFI_PARTITION is found + formatted + mounted by setup_efi_partition()
    ## below, via blkid PARTLABEL=EFI-SYSTEM.
  else
    ## Legacy/BIOS whole-disk: single Linux partition (original behavior).
    echo_info "Creating single-partition BIOS layout..."
    set_root_partition 1
    printf "g\nn\n\n\n\nw\n" | fdisk ${CHRX_TARGET_DISK} > /dev/null
  fi

  eval_try partprobe ${CHRX_TARGET_DISK} 2>/dev/null
  eval_try partx -u ${CHRX_TARGET_DISK} 2>/dev/null
  sleep 1
  fdisk -l ${CHRX_TARGET_DISK}
  echo_info "OK"
else
  ## Prefer the offline ChromeOS-GPT detector (works from a live USB); fall back
  ## to rootdev when running from within ChromeOS or if detection comes up empty.
  CHRX_TARGET_DISK="$(get_largest_cros_blockdev)"
  [ -z "${CHRX_TARGET_DISK}" ] && CHRX_TARGET_DISK="`rootdev -d -s 2>/dev/null`"
  echo_info "Setting up target disk ${CHRX_TARGET_DISK} partitions..."
  # Do partitioning (if we haven't already)
  ckern_size="`cgpt show -i 6 -n -s -q ${CHRX_TARGET_DISK}`"
  croot_size="`cgpt show -i 7 -n -s -q ${CHRX_TARGET_DISK}`"
  state_size="`cgpt show -i 1 -n -s -q ${CHRX_TARGET_DISK}`"

  max_os_size=$((${state_size}/1024/1024/2))
  rec_os_size=$((${max_os_size} - 1))
  # If KERN-C and ROOT-C are one, we partition, otherwise assume they're what they need to be...
  if [ "${CHRX_SKIP_PARTITIONING}" = "1" ] && [ "${ckern_size}" = "1" -o "${croot_size}" = "1" ]; then
    ## Skip-partitioning mode: set up KERN-C and ROOT-C in free space
    ## without rebooting. Used with external partitioning tools like CRaP
    ## (ChromeOS Automated Partitioning) that shrink the stateful partition
    ## but leave KERN-C/ROOT-C at 1 sector.
    ##
    ## We do the same partition math as chrx's normal "first pass" but use
    ## partx -u to update the kernel's partition table instead of rebooting.
    ## This allows the install to continue in a single pass.

    echo_info "CHRX_SKIP_PARTITIONING is set -- setting up partitions without reboot."

    ## CRaP has ALREADY shrunk STATE (both the partition AND its filesystem) and
    ## left free space after it. STATE is FINAL -- we must NOT touch -i 1, or we
    ## would shrink the partition below its (CRaP-resized) filesystem and trigger a
    ## ChromeOS "missing or damaged" recovery powerwash on the next ChromeOS boot.
    ## So here we ONLY carve KERN-C + ROOT-C out of the free space AFTER STATE.

    carve_kernc_rootc

    echo_info "Partitions configured without reboot. Continuing to install..."

    ## Fall through to formatting/mounting below (the "second pass" path)

  elif [ "${ckern_size}" = "1" -o "${croot_size}" = "1" ]; then
    while :
    do
      cat <<- EOF

	How much disk space should we reserve for Linux?

	Choose between 5 and ${max_os_size} GB (recommended: ${rec_os_size}).

	EOF
      echo_info "Enter size in GB [${rec_os_size}]: \c"
      prompt_if_interactive
      os_size=${PROMPT_RESPONSE}
      [ -z "${os_size}" ] && os_size=${rec_os_size}
      os_size_test=`echo ${os_size} | grep "^[0-9][0-9]*$"`
      if [ -z "${os_size_test}" ]; then
        echo_fail "\nNumbers only please!"
        continue
      fi
      if [ ${os_size} -lt 5 -o ${os_size} -gt ${max_os_size} ]; then
        echo_fail "\nPlease enter a number between 5 and ${max_os_size}!"
        continue
      fi
      break
    done

    # We've got our size in GB for ROOT-C so do the math...

    rootc_size=$((${os_size}*1024*1024*2)) # sector size for rootc
    kernc_size=32768 # kernc is always 16MB

    #new stateful size with rootc and kernc subtracted from original
    stateful_size=$((${state_size} - ${rootc_size} - ${kernc_size}))

    #start stateful at the same spot it currently starts at
    stateful_start="`cgpt show -i 1 -n -b -q ${CHRX_TARGET_DISK}`"

    #start kernc at stateful start plus stateful size
    kernc_start=$((${stateful_start} + ${stateful_size}))

    #start rootc at kernc start plus kernc size
    rootc_start=$((${kernc_start} + ${kernc_size}))

    echo "  stateful_start ${stateful_start}"
    echo "  stateful_size  ${stateful_size}"
    echo "  kernc_start    ${kernc_start}"
    echo "  kernc_size     ${kernc_size}"
    echo "  rootc_start    ${rootc_start}"
    echo "  rootc_size     ${rootc_size}"

    ## SAFE single-pass: shrink STATE FILESYSTEM-FIRST (no ChromeOS powerwash),
    ## then carve KERN-C/ROOT-C, then partx -u -- no reboot, no second pass.
    ## Legacy chrx shrank the PARTITION without the FILESYSTEM here and relied on
    ## ChromeOS flagging STATE "missing or damaged" -> powerwash + reboot + a
    ## second chrx run to rebuild it. resize_stateful_clean resizes ext4 to fit
    ## first, so ChromeOS mounts a valid, smaller STATE and never powerwashes.
    case "$CHRX_TARGET_DISK" in
      /dev/sd*) _statepart="${CHRX_TARGET_DISK}1" ;;
      *)        _statepart="${CHRX_TARGET_DISK}p1" ;;
    esac

    echo_warn "STATE on ${CHRX_TARGET_DISK} -> ${stateful_size} sectors (filesystem-first, no powerwash);"
    echo_warn "then carve KERN-C/ROOT-C into the freed space. Single pass, no reboot."
    echo_warn "Press [enter] to proceed or CTRL-C to quit: \c"
    prompt_if_interactive

    echo_info "\nShrinking STATE cleanly to make room for Linux."
    resize_stateful_clean "${stateful_size}" "${_statepart}" || {
      echo_fail "Clean STATE shrink failed -- aborting before any KERN-C/ROOT-C carve."
      exit 1
    }

    carve_kernc_rootc
  fi
fi

## set targets
if [ -z "$CHRX_ROOT_PARTITION" ]; then
  #CHRX_ROOT_PARTITION="${CHRX_TARGET_DISK}7"
  #if [[ "${CHRX_TARGET_DISK}" =~ "mmcblk" ]]; then
  #  CHRX_ROOT_PARTITION="${CHRX_TARGET_DISK}p7"
  #fi
  set_root_partition 7
fi

echo_info "\nInstalling to ${CHRX_ROOT_PARTITION}..."

eval_try umount -R ${CHRX_ROOT_PARTITION} 2>/dev/null
eval_try umount -R ${CHRX_INSTALL_ROOT} 2>/dev/null
if [ "`mount | grep ${CHRX_ROOT_PARTITION}`" ]; then
  echo_fail "Install target ${CHRX_ROOT_PARTITION} is already mounted!\n"
  echo_warn "Unmount manually (sudo umount -R ${CHRX_INSTALL_ROOT}) or reboot"
  echo_warn "to try again."
  exit 1
fi

## Idempotency: if ROOT-C already holds an OS install, reuse it (skip format +
## rootfs extract) so chrx can be re-run to redo only later stages (chroot/grub)
## without wiping a good install. Set CHRX_FORCE_FORMAT=1 to wipe & reinstall.
CHRX_SKIP_ROOTFS=
mkdir -p ${CHRX_INSTALL_ROOT}
_rootc_fstype=`blkid -p -s TYPE -o value ${CHRX_ROOT_PARTITION} 2>/dev/null`
if [ -z "${CHRX_FORCE_FORMAT}" ] && [ "${_rootc_fstype}" = "ext4" ] \
   && mount -t ext4 ${CHRX_ROOT_PARTITION} ${CHRX_INSTALL_ROOT} 2>/dev/null \
   && { [ -e "${CHRX_INSTALL_ROOT}/etc/os-release" ] \
        || [ -d "${CHRX_INSTALL_ROOT}/etc/apk" ] \
        || [ -x "${CHRX_INSTALL_ROOT}/sbin/init" ]; }; then
  echo_info "${CHRX_ROOT_PARTITION} already holds an install -- reusing (skip format + rootfs)."
  echo_info "  (set CHRX_FORCE_FORMAT=1 to wipe and reinstall from scratch.)"
  CHRX_SKIP_ROOTFS=1
else
  ## no existing install (or forced) -- format fresh and mount
  umount ${CHRX_INSTALL_ROOT} 2>/dev/null
  eval_crit mkfs.ext4 ${VERBOSITY_MKFS} -F ${CHRX_ROOT_PARTITION}
  echo_info "Preparing installation root directory ${CHRX_INSTALL_ROOT}"
  rm -rf ${CHRX_INSTALL_ROOT}
  mkdir -p ${CHRX_INSTALL_ROOT}
  if [ ! -d "${CHRX_INSTALL_ROOT}" ]; then
    echo_fail "fatal: Unable to create installation root directory!"
    exit 1
  fi
  eval_crit mount -t ext4 ${CHRX_ROOT_PARTITION} ${CHRX_INSTALL_ROOT}
fi
export CHRX_SKIP_ROOTFS

## Set up EFI partition if system is UEFI-booted
setup_efi_partition

## clear error variable, which is checked in the calling script
SETUP_STORAGE_ERROR=""

