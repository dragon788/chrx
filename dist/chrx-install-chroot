  ## install proper hwspec pkgs
  case "$CHRX_HWCPUF" in
    "Intel Sandy Bridge") hwspec_pkgs="galliumos-sandy" ;;
    "Intel Ivy Bridge")   hwspec_pkgs="galliumos-sandy" ;;
    "Intel Haswell")      hwspec_pkgs="galliumos-haswell" ;;
