write_default_fstab()
{
  ## FIXME be smarter here
  if [ -z "${CHRX_ROOT_PARTITION}" ]; then
    echo_title_red "Unable to configure default fstab, CHRX_ROOT_PARTITION is unset!"
    return
  fi
  echo_title "Configuring /etc/fstab..."
  echo "${CHRX_ROOT_PARTITION} / ext4 defaults,discard,relatime 1 1" >> /etc/fstab

  ## Add EFI partition to fstab if UEFI system
  if is_efi_bootloader; then
    ## Find EFI partition if not already set
    if [ -z "${CHRX_EFI_PARTITION}" ]; then
      find_and_mount_efi_partition
    fi
    if [ -n "${CHRX_EFI_PARTITION}" ]; then
      echo_title "Adding EFI partition to fstab..."
      ## fsck pass MUST be 0 and nofail MUST be set. On eMMC ChromeOS-x86 boxes the
      ## EFI device node can enumerate AFTER OpenRC localmount runs fsck.fat, which
      ## then aborts boot ("Filesystems couldn't be fixed -> rc: Aborting!") and
      ## prevents networking/sshd from starting. The ESP is only read by edk2/grub
      ## PRE-OS, never at runtime, so skip the boot-time fsck (pass 0) and make a
      ## missing node non-fatal (nofail). Do NOT "fix" this back to pass=1.
      echo "${CHRX_EFI_PARTITION} /boot/efi vfat umask=0077,nofail 0 0" >> /etc/fstab
      mkdir -p /boot/efi
    else
      echo_title_yel "WARNING: No EFI partition found for fstab"
    fi
  fi

  ## Idempotent safety net (same fsck-race rationale as above): force ANY existing
  ## /boot/efi entry to nofail + fsck pass 0. No-op if already correct; otherwise
  ## keep a timestamped .bak before rewriting. Covers pre-existing fstabs and any
  ## future path that re-emits the line with a nonzero pass.
  if [ -f /etc/fstab ] && grep -qE '[[:space:]]/boot/efi[[:space:]]' /etc/fstab; then
    if ! grep -qE '[[:space:]]/boot/efi[[:space:]].*nofail.*[[:space:]]0[[:space:]]+0[[:space:]]*$' /etc/fstab; then
      cp -a /etc/fstab "/etc/fstab.bak.$(date +%s)"
      awk '$2=="/boot/efi"{ o=$4; if(o !~ /(^|,)nofail($|,)/) o=o",nofail"; print $1, $2, $3, o, "0", "0"; next } {print}' \
        /etc/fstab > /etc/fstab.chrx.tmp && mv /etc/fstab.chrx.tmp /etc/fstab
      echo_title "Normalized /boot/efi fstab entry to nofail + fsck pass 0 (fsck-race fix)"
    fi
  fi
}

create_fakebins()
{
  ## create fake bins to stymie ubuntu's poor autostart hygiene
  local _bins="initctl invoke-rc.d restart start stop start-stop-daemon service"
  rm -rf /tmp/fakebin
  mkdir -p /tmp/fakebin
  for bin in $_bins; do
    ln -s /bin/true /tmp/fakebin/${bin}
  done
  export PATH=/tmp/fakebin:$PATH
}

find_and_mount_efi_partition()
{
  ## Try to find and mount the EFI partition inside the chroot.
  ## Called when CHRX_EFI_PARTITION is empty but we know we need EFI.

  local _efi_dev=""

  ## Method 1: blkid by PARTLABEL
  _efi_dev=$(blkid --match-token PARTLABEL=EFI-SYSTEM -o device 2>/dev/null \
    | grep "^${CHRX_TARGET_DISK}" | head -1)

  ## Method 2: blkid by TYPE=vfat on partition 12
  if [ -z "$_efi_dev" ]; then
    local _p12=""
    case "$CHRX_TARGET_DISK" in
      /dev/sd*)     _p12="${CHRX_TARGET_DISK}12" ;;
      /dev/mmcblk*) _p12="${CHRX_TARGET_DISK}p12" ;;
      /dev/nvme*)   _p12="${CHRX_TARGET_DISK}p12" ;;
    esac
    if [ -n "$_p12" ] && [ -b "$_p12" ]; then
      _efi_dev="$_p12"
    fi
  fi

  ## Method 3: cgpt to check if partition 12 exists
  if [ -z "$_efi_dev" ] && command -v cgpt >/dev/null 2>&1; then
    local _label=$(cgpt show -i 12 -l ${CHRX_TARGET_DISK} 2>/dev/null)
    if [ "$_label" = "EFI-SYSTEM" ]; then
      case "$CHRX_TARGET_DISK" in
        /dev/sd*)     _efi_dev="${CHRX_TARGET_DISK}12" ;;
        /dev/mmcblk*) _efi_dev="${CHRX_TARGET_DISK}p12" ;;
        /dev/nvme*)   _efi_dev="${CHRX_TARGET_DISK}p12" ;;
      esac
    fi
  fi

  if [ -z "$_efi_dev" ]; then
    echo_title_red "Could not find EFI partition on ${CHRX_TARGET_DISK}"
    return 1
  fi

  echo_title "Found EFI partition: ${_efi_dev}"
  CHRX_EFI_PARTITION="$_efi_dev"

  ## Mount it
  mkdir -p /boot/efi
  if ! mountpoint -q /boot/efi; then
    mount -t vfat ${_efi_dev} /boot/efi
    if [ $? -ne 0 ]; then
      ## May need formatting first
      echo_title_yel "Formatting EFI partition ${_efi_dev}..."
      mkfs.vfat -F 32 -n EFI ${_efi_dev}
      mount -t vfat ${_efi_dev} /boot/efi
    fi
  fi

  return $?
}

install_grub()
{
  ## GRUB: modify boot settings
  ## unfortunately, we have to do this in the chroot.
  if [ "${CHRX_CONFIGURE_GRUB_ENABLED}" ]; then
    configure_grub
  else
    echo_title_yel "(skipping chrx grub config)"
  fi

  echo_title "Installing GRUB (${CHRX_BOOTLOADER})..."

  ## Build grub-install command based on bootloader type
  local EFI_DIR_CMD=""
  if is_efi_bootloader; then
    echo_title "Setting up EFI boot..."

    ## Try to mount EFI partition if not already done
    if [ -z "${CHRX_EFI_PARTITION}" ] || ! mountpoint -q /boot/efi; then
      echo_title_yel "EFI partition not pre-mounted, searching..."
      find_and_mount_efi_partition
    else
      ## CHRX_EFI_PARTITION is set, ensure it's mounted
      if ! mountpoint -q /boot/efi; then
        mkdir -p /boot/efi
        mount ${CHRX_EFI_PARTITION} /boot/efi
      fi
    fi

    ## Always use x86_64-efi target for EFI bootloader
    if mountpoint -q /boot/efi; then
      EFI_DIR_CMD="--removable --target=x86_64-efi --efi-directory=/boot/efi"
      echo_title "EFI directory: /boot/efi (mounted)"
    else
      ## EFI partition not mounted but we still need the right target
      ## Install to /boot as fallback
      echo_title_yel "WARNING: EFI partition not mounted, installing to /boot"
      EFI_DIR_CMD="--removable --target=x86_64-efi --efi-directory=/boot"
    fi
  fi

  grub-install ${EFI_DIR_CMD} --boot-directory=/boot ${CHRX_TARGET_DISK} --force
  grub-mkconfig -o /boot/grub/grub.cfg

  ## Write a chain-loading grub.cfg on the EFI partition so Tianocore's
  ## GRUB can find the real config on the root partition automatically.
  if is_efi_bootloader && mountpoint -q /boot/efi; then
    echo_title "Writing EFI grub.cfg chain-loader..."

    ## Get the UUID of the root partition for search.fs_uuid
    local _root_uuid=$(blkid -s UUID -o value ${CHRX_ROOT_PARTITION} 2>/dev/null)

    ## Write to both possible locations GRUB looks for config
    for _cfgdir in /boot/efi/EFI/BOOT /boot/efi/grub; do
      mkdir -p ${_cfgdir}
      if [ -n "$_root_uuid" ]; then
        cat > ${_cfgdir}/grub.cfg << GRUBCFG
# Auto-generated by chrx — chain-load real grub.cfg from root partition
search.fs_uuid ${_root_uuid} root
set prefix=(\$root)/boot/grub
configfile \$prefix/grub.cfg
GRUBCFG
      else
        ## Fallback: hardcode partition number (less portable but works)
        local _gpt_num=$(echo ${CHRX_ROOT_PARTITION} | grep -o '[0-9]*$')
        cat > ${_cfgdir}/grub.cfg << GRUBCFG
# Auto-generated by chrx — chain-load real grub.cfg from root partition
set root=(hd0,gpt${_gpt_num})
set prefix=(\$root)/boot/grub
configfile \$prefix/grub.cfg
GRUBCFG
      fi
      echo_title "  Wrote ${_cfgdir}/grub.cfg"
    done
  fi
}

fedora_install_grub2()
{
  # fedora expects anaconda to set the defaults file
  cat << EOF > /etc/default/grub
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="$(sed 's, release .*$,,g' /etc/system-release)"
GRUB_DEFAULT=saved
GRUB_DISABLE_SUBMENU=true
GRUB_TERMINAL_OUTPUT="console"
GRUB_CMDLINE_LINUX="rhgb quiet intel_pstate=enable i915.modeset=1 tpm_tis.force=1 nmi_watchdog=panic,lapic elevator=noop noswap"
GRUB_DISABLE_RECOVERY="true"
GRUB_DISABLE_LINUX_UUID="true"
EOF

  echo_title "Installing GRUB2 (${CHRX_BOOTLOADER})..."

  local EFI_DIR_CMD=""
  if is_efi_bootloader && [ -n "${CHRX_EFI_PARTITION}" ]; then
    echo_title "Setting up EFI boot..."
    ## For Fedora UEFI, install shim and grub2-efi packages
    dnf ${VERBOSITY_DNF} -y install grub2-efi-x64 grub2-efi-x64-modules shim-x64

    ## Ensure EFI partition is mounted
    if ! mountpoint -q /boot/efi; then
      mkdir -p /boot/efi
      mount ${CHRX_EFI_PARTITION} /boot/efi
    fi

    ## Create EFI directory structure
    mkdir -p /boot/efi/EFI/fedora
    EFI_DIR_CMD="--removable --target=x86_64-efi --efi-directory=/boot/efi"
  else
    ## For Fedora Legacy/BIOS boot
    dnf ${VERBOSITY_DNF} -y install grub2 grub2-pc grub2-pc-modules
  fi

  grub2-install ${EFI_DIR_CMD} ${CHRX_TARGET_DISK} --force
  grub2-mkconfig -o /boot/grub2/grub.cfg

  ## Copy GRUB config to EFI partition for some firmware
  if is_efi_bootloader; then
    cp /boot/grub2/grub.cfg /boot/efi/EFI/fedora/ 2>/dev/null || true
  fi
}

