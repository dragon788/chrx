alpine_setup_repos()
{
  echo_title "Configuring apk repositories (${CHRX_ALPINE_BRANCH})."
  mkdir -p /etc/apk
  cat > /etc/apk/repositories <<EOF
https://dl-cdn.alpinelinux.org/alpine/${CHRX_ALPINE_BRANCH}/main
https://dl-cdn.alpinelinux.org/alpine/${CHRX_ALPINE_BRANCH}/community
EOF
  case "${CHRX_OS_DISTRO}" in
    pmos|postmarketos)
      echo "${CHRX_PMOS_REPO}" >> /etc/apk/repositories
      ## pmOS binary repo is signed — trust its key, else apk needs --allow-untrusted.
      ## Strategy: fetch the CURRENT key (so an upstream key rotation is picked up),
      ## and fall back to the copy bundled in the chrx dist if the fetch fails.
      ## Two gotchas this works around:
      ##   - the Alpine minirootfs ships busybox WGET, not curl, so use wget;
      ##   - postmarketOS moved off gitlab.com to their own instance
      ##     (gitlab.postmarketos.org, default branch 'main', keys now live under
      ##     main/postmarketos-keys/), so the old gitlab.com/.../master/keys URL 404s.
      mkdir -p /etc/apk/keys
      _pmos_key=/etc/apk/keys/build.postmarketos.org.rsa.pub
      _pmos_key_url="https://gitlab.postmarketos.org/postmarketOS/pmaports/-/raw/main/main/postmarketos-keys/build.postmarketos.org.rsa.pub"
      _pmos_key_bundled="${CHRX_CACHE_DIR}/keys/build.postmarketos.org.rsa.pub"
      if wget -q -O "${_pmos_key}" "${_pmos_key_url}" 2>/dev/null \
         && grep -q 'BEGIN PUBLIC KEY' "${_pmos_key}" 2>/dev/null; then
        echo_title "Fetched current pmOS signing key."
      elif [ -s "${_pmos_key_bundled}" ]; then
        echo_title_yel "pmOS key fetch failed; using bundled copy."
        cp "${_pmos_key_bundled}" "${_pmos_key}"
      else
        rm -f "${_pmos_key}"
        echo_title_yel "WARN: no pmOS signing key (fetch failed, no bundle); pmOS repo will be untrusted."
      fi
      ;;
  esac
}

alpine_install_base()
{
  echo_title "Updating apk index."
  apk --no-cache update
  echo_title "Installing Alpine base system + kernel + bootloader."
  ## linux-firmware-none satisfies the linux-lts firmware dep without the huge
  ## firmware blob set (fine for a wired server node). bash for chrx scripts.
  ## doas (+ doas-sudo-shim for a `sudo` compat command) — NOT the sudo
  ## package: pmOS's postmarketos-base already pulls doas-sudo-shim, and the
  ## real sudo package would collide with it over /usr/bin/sudo. shadow gives
  ## useradd/usermod/chpasswd that add_first_user relies on.
  apk --no-cache add \
    alpine-base bash \
    linux-lts linux-firmware-none mkinitfs \
    e2fsprogs e2fsprogs-extra dosfstools util-linux \
    grub grub-efi efibootmgr \
    openrc openssh chrony tzdata shadow doas doas-sudo-shim ifupdown-ng
}

alpine_setup_doas()
{
  ## pmOS already ships a doas rule permitting :wheel (via postmarketos-base),
  ## so don't touch its config. For plain Alpine, grant the wheel group.
  case "${CHRX_OS_DISTRO}" in
    pmos|postmarketos) return 0 ;;
  esac
  echo_title "Configuring doas for the wheel group."
  if [ ! -f /etc/doas.conf ] || ! grep -qE '^permit.*:wheel' /etc/doas.conf 2>/dev/null; then
    echo 'permit persist :wheel' >> /etc/doas.conf
  fi
}

pmos_install_overlay()
{
  case "${CHRX_OS_DISTRO}" in
    pmos|postmarketos) ;;
    *) return 0 ;;
  esac
  echo_title "Installing postmarketOS overlay (base + device-generic-x86_64)."
  apk --no-cache update
  ## postmarketos-base conflicts with alpine-base, and postmarketos-mkinitfs
  ## conflicts with Alpine's mkinitfs; apk will NOT auto-replace, so we must
  ## remove the Alpine equivalents first (postmarketos-base re-provides them).
  ## Guard: only delete them if postmarketos-base is actually available (i.e. the
  ## pmOS repo is trusted + indexed) — otherwise we'd strip the base and leave a
  ## broken system; if not available we just stay on the Alpine base.
  if apk --no-cache list postmarketos-base 2>/dev/null | grep -q '^postmarketos-base-'; then
    apk --no-cache del --no-scripts alpine-base mkinitfs 2>/dev/null || true
    apk --no-cache add postmarketos-base postmarketos-mkinitfs device-generic-x86_64 \
      || echo_title_red "WARN: pmOS base install failed — check repo/network."
  else
    echo_title_red "WARN: postmarketos-base not found (pmOS repo untrusted/unreachable?); staying on Alpine base."
  fi
  case "${CHRX_OS_ENVIRONMENT}" in
    sxmo-de-sway)
      echo_title "Installing postmarketOS UI: sxmo-de-sway (fleet image)."
      apk --no-cache add postmarketos-ui-sxmo-de-sway \
        || apk --no-cache --allow-untrusted add postmarketos-ui-sxmo-de-sway \
        || echo_title_yel "WARN: sxmo-de-sway UI install failed."
      ;;
    *) echo_title "pmOS environment '${CHRX_OS_ENVIRONMENT}' — base only (no UI)." ;;
  esac
}

alpine_setup_network()
{
  echo_title "Configuring eth0 (DHCP via ifupdown-ng / busybox udhcpc)."
  mkdir -p /etc/network
  cat > /etc/network/interfaces <<EOF
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
EOF
}

alpine_setup_services()
{
  echo_title "Enabling OpenRC services."
  for s in devfs dmesg mdev hwdrivers; do rc-update add $s sysinit 2>/dev/null; done
  for s in modules sysctl hostname bootmisc syslog networking; do rc-update add $s boot 2>/dev/null; done
  for s in sshd chronyd local; do rc-update add $s default 2>/dev/null; done
  for s in mount-ro killprocs savecache; do rc-update add $s shutdown 2>/dev/null; done
  ## permit root ssh for headless server bring-up
  sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config 2>/dev/null
}

alpine_set_timezone()
{
  echo_title "Setting timezone to \"${CHRX_TZ}\"."
  if [ -f "/usr/share/zoneinfo/${CHRX_TZ}" ]; then
    cp "/usr/share/zoneinfo/${CHRX_TZ}" /etc/localtime
    echo "${CHRX_TZ}" > /etc/timezone
  fi
}

alpine_set_root_password()
{
  ## headless bring-up credential — CHANGE AFTER FIRST BOOT
  echo_title "Setting root password (root:root — change after first boot!)."
  echo "root:root" | chpasswd
}

alpine_write_grub_default()
{
  echo_title "Writing /etc/default/grub (Alpine/pmOS)."
  mkdir -p /etc/default
  cat > /etc/default/grub <<EOF
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="${CHRX_OS_DISTRO_DISPLAYNAME}"
GRUB_CMDLINE_LINUX_DEFAULT="quiet rootfstype=ext4"
GRUB_CMDLINE_LINUX=""
GRUB_DISABLE_RECOVERY=true
GRUB_TERMINAL_OUTPUT=console
EOF
}

alpine_build_initramfs()
{
  ## In a chroot the apk kernel trigger may not have run mkinitfs; do it.
  local _kv
  for _kv in $(ls /lib/modules 2>/dev/null); do
    echo_title "Generating initramfs for kernel ${_kv} (mkinitfs)."
    mkinitfs "${_kv}" || echo_title_yel "WARN: mkinitfs failed for ${_kv}"
  done
}

